# ========================================================
# TECH SHUTTER HUB - Hostinger Apache Configuration
# ========================================================
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # API endpoints routing
    RewriteRule ^api/projects/?$ api/projects.php [QSA,L]
    RewriteRule ^api/inquire/?$ api/inquire.php [QSA,L]
    RewriteRule ^api/career-apply/?$ api/career-apply.php [QSA,L]
    RewriteRule ^api/login/?$ api/login.php [QSA,L]
    RewriteRule ^api/inquiries/?$ api/inquiries.php [QSA,L]
    RewriteRule ^api/stats/?$ api/stats.php [QSA,L]
    RewriteRule ^api/upload/?$ api/upload.php [QSA,L]

    # Clean URL routing without extensions
    RewriteRule ^wedding/?$ wedding.php [L]
    RewriteRule ^services/?$ services.php [L]
    RewriteRule ^career/?$ career.php [L]
    RewriteRule ^work/?$ work.php [L]
    RewriteRule ^contact/?$ contact.php [L]
    RewriteRule ^admin/?$ admin.php [L]
    RewriteRule ^gallery/?$ gallery.php [L]

    # Check for direct file match
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]

    # Fallback to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Caching for high performance
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

